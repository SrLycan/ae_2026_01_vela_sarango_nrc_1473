# Copia este archivo a .env (en la raíz del monorepo) y completa los valores reales.
# .env NO se commitea (ver .gitignore).

# -- Cognito User Pool (compartido por users y spotsapp) --
COGNITO_ISSUER_URI=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>

# -- Base de datos: users --
USERS_DB_USERNAME=users
USERS_DB_PASSWORD=cambia-esta-contrasena

# -- Base de datos: spotsapp --
SPOTSAPP_DB_USERNAME=spotsapp
SPOTSAPP_DB_PASSWORD=cambia-esta-contrasena

# -- S3 (solo lo usa spotsapp) --
AWS_S3_BUCKET=tu-bucket-s3
AWS_REGION=us-east-1
# Déjalas VACÍAS en EC2 con IAM Role adjunto (recomendado, ver docs/despliegue-ec2.md).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -- pgAdmin (explorador de BD) --
PGADMIN_EMAIL=admin@spotsapp.local
PGADMIN_PASSWORD=cambia-esta-contrasena
